{
  "name": "omp-documenter",
  "version": "2.0.1",
  "description": "Evidence-led repository documentation, maintenance, coverage and safe publishing for Oh My Pi",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "omp": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "bin": {
    "omp-documenter": "./scripts/documenter.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check lib/engine.mjs && node --check scripts/documenter.mjs"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "skills",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "dependencies": {
    "@xberg-io/xberg": "1.5.4",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.3",
    "tree-sitter-typescript": "0.23.2"
  }
}
